{
  "name": "dsh-plugin-spacelens",
  "version": "0.1.1",
  "type": "module",
  "description": "The Space Lens workbench as a DeepSeek Harness panel: the directory the current session is working in, scanned and explored by Space Lens itself.",
  "license": "MIT",
  "icon": "./icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HuakunShen/space-lens.git",
    "directory": "apps/dsh"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "space-lens",
    "disk-usage"
  ],
  "meta": {
    "title": "Space Lens",
    "description": "A disk workbench for the directory this session is working in."
  },
  "exports": {
    ".": "./dist/host.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "dist",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "cd ../.. && yarn build:dsh",
    "prepublishOnly": "yarn build"
  },
  "dependencies": {
    "space-lens": "^0.2.8"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
