{
  "name": "@space-lens/web",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Space Lens web workbench: one static SPA served by spacelens serve, deployable to Cloudflare as a PWA, and compiled into the Tauri desktop app.",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:desktop": "SPACLENS_BUILD_TARGET=desktop vite build",
    "build:xross-local": "SPACLENS_BUILD_TARGET=xross-local vite build && node scripts/finalize-xross-build.mjs local",
    "build:xross-hosted": "SPACLENS_BUILD_TARGET=xross-hosted vite build && node scripts/finalize-xross-build.mjs hosted",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "prettier --check .",
    "deploy": "yarn build && wrangler deploy",
    "deploy:dry-run": "yarn build && wrangler deploy --dry-run"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.0",
    "shadcn-svelte": "^1.3.0",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "@space-lens/client": "workspace:*",
    "@space-lens/contract": "workspace:*",
    "@space-lens/web-ui": "workspace:*",
    "@tauri-apps/api": "^2.11.1",
    "mode-watcher": "^1.1.0"
  }
}
