{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Space Lens",
  "version": "0.1.0",
  "identifier": "sh.huakun.spacelens.desktop",
  "build": {
    "frontendDist": "../../web/build-desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Space Lens",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "deb",
      "appimage",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/HuakunShen/space-lens/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI4ODZFNDZGRjJFOUQxQUMKUldTczBlbnliK1NHS0JvQW84c0liTFlDSGUzanJxcW02Si9RVXFUUUVjMWRiVktPMUd4a2FsS1gK"
    }
  }
}