{
  "name": "@space-lens/cli",
  "type": "module",
  "version": "0.2.1",
  "description": "OpenTUI-powered CLI for Space Lens scanning and cleanup.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HuakunShen/space-lens.git",
    "directory": "apps/tui"
  },
  "bin": {
    "spacelens": "dist/cli.mjs",
    "spacelens-web": "dist/web-cli.mjs"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./cli": "./dist/cli.mjs",
    "./web-api": {
      "types": "./src/web-api.ts",
      "import": "./dist/web-api.mjs"
    },
    "./web-service": {
      "types": "./src/web-service.ts",
      "import": "./dist/web-service.mjs"
    },
    "./web-cli": "./dist/web-cli.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && node scripts/copy-web-assets.mjs",
    "dev:web": "node --import tsx src/web-cli.ts",
    "dev:api": "node --import tsx src/web-cli.ts --api-only",
    "dev": "bun src/cli.ts",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@effect/cli": "^0.75.2",
    "@effect/platform": "^0.96.1",
    "@effect/platform-node": "^0.107.0",
    "@effect/printer": "^0.49.0",
    "@effect/printer-ansi": "^0.49.0",
    "@effect/typeclass": "^0.40.0",
    "@hono/node-server": "^2.0.4",
    "@opentui/core": "^0.4.1",
    "effect": "^3.21.3",
    "hono": "^4.12.25",
    "kkrpc": "2.0.0",
    "space-lens": "^0.2.0",
    "web-tree-sitter": "0.25.10",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/ws": "^8.18.1",
    "tsdown": "^0.22.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
